{
    "manifest_version": 3,
    "name": "Try-On for Steam Profiles",
    "version": "1.50",
    "description": "Preview Steam profile backgrounds, avatars, avatar frames, mini profiles and themes before you buy or equip them",
    "homepage_url": "https://github.com/brunosuzano/try-on-for-steam-profiles",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Try-On for Steam Profiles",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png"
        }
    },
    "permissions": ["storage"],
    "host_permissions": [
        "https://steamcommunity.com/*",
        "https://store.steampowered.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://steamcommunity.com/*",
                "https://store.steampowered.com/points/*"
            ],
            "js": ["try-on-for-steam-profiles.user.js"],
            "run_at": "document_start",
            "all_frames": false
        }
    ]
}
